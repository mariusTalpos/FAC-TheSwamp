# Copy to `.env.local` for Next.js local development (never commit real secrets).

# PostgreSQL (example matches root docker-compose.yml)
DATABASE_URL=postgresql://fac:fac@localhost:5432/fac_app

# Auth.js (JWT sessions with Credentials provider) — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-long-random-secret
AUTH_URL=http://localhost:3000

# SMTP / transactional email (password reset, invitations)
EMAIL_FROM=noreply@example.com
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false

# Used in password-reset / invitation emails (local dev default).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Show dev login hints on /login (local only)
NEXT_PUBLIC_DEV_LOGIN_HINT=true

# Epic E2: optional public team/roster pages (default off)
PUBLIC_TEAM_ROSTER=false

# Epic E3: optional public event metadata pages (default off)
PUBLIC_EVENTS=false
